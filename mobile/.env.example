# Agri-Insight Beacon - Environment Configuration
# -----------------------------------------------
# SETUP INSTRUCTIONS FOR EACH DEVELOPER:
#
# 1. Copy this file:  cp .env.example .env
# 2. The default URL below points to the live cloud backend.
#    Everyone uses the same URL - no local server needed!
#
# Cloud backend (use this for physical devices & APK):
API_BASE_URL=https://agri-insight-api-qb1q.onrender.com/api
ENVIRONMENT=production
#
# Local development only (Android emulator or web):
# API_BASE_URL=http://localhost:3001/api
# ENVIRONMENT=development
