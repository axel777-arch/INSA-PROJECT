# Agri-Insight Beacon - Environment Configuration
# -----------------------------------------------
# SETUP INSTRUCTIONS FOR EACH DEVELOPER:
#
# 1. Copy this file:  cp .env.example .env
# 2. Set your IP below based on how you're running the app:
#
#    - Flutter Web / Android Emulator:
#        API_BASE_URL=http://localhost:3001/api
#
#    - Physical Android Device (replace with YOUR computer's IP):
#        API_BASE_URL=http://<YOUR_LOCAL_IP>:3001/api
#        (Find your IP: run `ipconfig` on Windows, look for "IPv4 Address")
#
# Your .env file is .gitignored — changes here only affect your machine.
API_BASE_URL=http://localhost:3001/api
ENVIRONMENT=development
