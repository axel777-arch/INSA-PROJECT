# ── Backend (copy to backend/.env) ────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Docker postgres (docker-compose): port 5433 on host maps to 5432 in container
DATABASE_URL=postgresql://agri_user:agri_password@localhost:5433/agri_insight

JWT_ACCESS_SECRET=super_secret_jwt_access_key_that_is_at_least_32_characters_long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=Admin$2026
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:3000

# ── Mobile (mobile/.env) ───────────────────────────────────────────────────────
# Android emulator: use 10.0.2.2 to reach host machine
# Physical device: use your machine's LAN IP (e.g. 192.168.x.x)
API_BASE_URL=http://10.0.2.2:3000/api
ENVIRONMENT=development
