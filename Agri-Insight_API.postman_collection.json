    {
      "name": "01. System Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Health Check returns 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql(\"ok\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02. Auth - Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"admin@gmail.com\",\n  \"password\": \"Admin$2026\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Admin login returns 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "    const json = pm.response.json();",
              "    const token = json.accessToken || json.token;",
              "    pm.expect(token).to.be.a('string');",
              "    pm.collectionVariables.set(\"adminToken\", token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
