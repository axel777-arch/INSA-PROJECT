{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "database/**/*.ts",
    "drizzle.config.ts",
    "backend/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "backend/node_modules",
    "dist",
    "backend/dist"
  ]
}
